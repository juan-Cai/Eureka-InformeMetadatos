  "dbas": [
    {"id":1,"descripcion":"Comprende que los sistemas del cuerpo humano están formados por órganos, tejidos y células, y que la estructura de cada célula se relaciona con su función."},
    {"id":2,"descripcion":"Comprende que en los seres humanos la nutrición involucra el funcionamiento integrado de los sistemas digestivo, respiratorio y circulatorio."},
    {"id":3,"descripcion":"Explica los ciclos del día y la noche, las estaciones y las fases de la Luna a partir del movimiento de la Tierra y la Luna."},
    {"id":4,"descripcion":"Comprende que algunos materiales son buenos conductores de la electricidad y que un circuito requiere una fuente, conductores e interruptor."},
    {"id":5,"descripcion":"Comprende las relaciones entre los seres vivos y su entorno en los ecosistemas, y el impacto de las actividades humanas sobre ellos."}
  ],
